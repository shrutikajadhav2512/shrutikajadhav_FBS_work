   "source": [
    "### Write code to replace the odd numbers by -1 in the array created by using random.randint( 1 , 50,20)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "341e952c-e58d-4617-96ae-8de1a109c4ce",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "eb0cbd48-523e-4093-8cfa-7836155c4ae5",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "array([41, 29, 25, 15,  4, 30, 49, 27,  8, 42,  2,  6, 45, 25, 29,  3, 20,\n",
       "       20, 10,  2], dtype=int32)"
      ]
     },
     "execution_count": 10,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "arr=np.random.randint(1,50,20)\n",
    "arr"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "1b43e61e-8b55-477e-b6b0-773baaa524d4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[-1 -1 -1 -1  4 30 -1 -1  8 42  2  6 -1 -1 -1 -1 20 20 10  2]\n"
     ]
    }
   ],
   "source": [
    "for i in range(len(arr)):\n",
    "    if(arr[i]%2!=0):\n",
    "        arr[i]=-1\n",
    "print(arr)"
   ]
